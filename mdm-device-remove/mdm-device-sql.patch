+-- Safe device purge script for GERTEC_MDM_DEV (MySQL 5.7)
+-- Edit the identifier list below, run once with CALL ... (0) to preview,
+-- then change the call to CALL ... (1) to execute the delete.
+
+DROP PROCEDURE IF EXISTS purge_devices_by_identifier;
+DELIMITER //
+
+CREATE PROCEDURE purge_devices_by_identifier(IN p_apply_delete TINYINT(1))
+BEGIN
+  DROP TEMPORARY TABLE IF EXISTS tmp_device_identifiers;
+  CREATE TEMPORARY TABLE tmp_device_identifiers (
+    identifier VARCHAR(45) NOT NULL PRIMARY KEY
+  ) ENGINE=MEMORY;
+
+  -- Add one or more identifiers here.
+  INSERT INTO tmp_device_identifiers (identifier) VALUES
+    ('D8C222DFD8D6016F');
+
+  DROP TEMPORARY TABLE IF EXISTS tmp_device_targets;
+  CREATE TEMPORARY TABLE tmp_device_targets (
+    id BIGINT UNSIGNED NOT NULL PRIMARY KEY,
+    identifier VARCHAR(45) NOT NULL,
+    name VARCHAR(200) NULL
+  ) ENGINE=MEMORY;
+
+  INSERT INTO tmp_device_targets (id, identifier, name)
+  SELECT d.id, d.identifier, d.name
+  FROM device d
+  JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY d.identifier;
+
+  SELECT 'target_devices' AS section, id, identifier, name
+  FROM tmp_device_targets
+  ORDER BY identifier;
+
+  SELECT 'preview_targets_loaded' AS section, COUNT(*) AS target_count
+  FROM tmp_device_targets;
+
+  IF p_apply_delete = 0 THEN
+    SELECT 'Preview only. Change the call to purge_devices_by_identifier(1) to execute the delete.' AS message;
+  ELSE
+    START TRANSACTION;
+
+    DELETE dd
+    FROM deviceDetails dd
+    JOIN tmp_device_targets t ON t.id = dd.device_id;
+
+    DELETE s
+    FROM state s
+    JOIN tmp_device_targets t ON t.id = s.device_id;
+
+    DELETE s
+    FROM state s
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY s.aws_device_id;
+
+    DELETE a
+    FROM alert a
+    JOIN tmp_device_targets t ON t.id = a.id_device;
+
+    DELETE dh
+    FROM deviceHistory dh
+    JOIN tmp_device_targets t ON t.id = dh.id_device;
+
+    DELETE dc
+    FROM device_certificate dc
+    JOIN tmp_device_targets t ON t.id = dc.id_device;
+
+    DELETE dhc
+    FROM device_history_communication dhc
+    JOIN tmp_device_targets t ON t.id = dhc.id_device;
+
+    DELETE dhc
+    FROM device_history_communication dhc
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY dhc.identifier;
+
+    DELETE dk
+    FROM device_key dk
+    JOIN tmp_device_targets t ON t.id = dk.id_device;
+
+    DELETE dla
+    FROM device_log_analysis dla
+    JOIN tmp_device_targets t ON t.id = dla.id_device;
+
+    DELETE drch
+    FROM device_roll_consumption_history drch
+    JOIN tmp_device_targets t ON t.id = drch.device_id;
+
+    DELETE dwc
+    FROM device_weekly_communication dwc
+    JOIN tmp_device_targets t ON t.id = dwc.id_device;
+
+    DELETE dwc
+    FROM device_weekly_communication dwc
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY dwc.identifier;
+
+    DELETE eh
+    FROM effectivenessHistory eh
+    JOIN tmp_device_targets t ON t.id = eh.idDevice;
+
+    DELETE mv
+    FROM mv_device_data_consumption_daily mv
+    JOIN tmp_device_targets t ON t.id = mv.id_device;
+
+    DELETE mv
+    FROM mv_device_data_consumption_daily mv
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY mv.identifier;
+
+    DELETE n
+    FROM notifications n
+    JOIN tmp_device_targets t ON t.id = n.id_device;
+
+    DELETE da
+    FROM device_app da
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY da.identifier;
+
+    DELETE dhd
+    FROM deviceHistoryDiff dhd
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY dhd.identifier;
+
+    DELETE it
+    FROM identifier_token it
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY it.identifier;
+
+    DELETE iar
+    FROM installed_apps_request iar
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY iar.identifier;
+
+    DELETE dt
+    FROM device_teste dt
+    JOIN tmp_device_identifiers t ON BINARY t.identifier = BINARY dt.identifier;
+
+    DELETE d
+    FROM device d
+    JOIN tmp_device_targets t ON t.id = d.id;
+
+    COMMIT;
+
+    SELECT 'Delete completed.' AS message;
+  END IF;
+END//
+
+DELIMITER ;
+
+CALL purge_devices_by_identifier(0);
+
+-- After reviewing the preview results, change the call above to:
+-- CALL purge_devices_by_identifier(1);
+
+DROP PROCEDURE purge_devices_by_identifier;
+
+-- QUICK USAGE (DOCKER)
+-- 1) Configure identifiers in INSERT INTO tmp_device_identifiers (one or many):
+--      ('ID_1'),
+--      ('ID_2');
+-- 2) Test mode (preview, no delete): keep CALL purge_devices_by_identifier(0);
+-- 3) Definitive mode (delete): change to CALL purge_devices_by_identifier(1);
+-- 4) Run from PowerShell:
+--      Get-Content -Raw ".\delete_devices_safe.sql" |
+--      docker exec -i mysqlgertec mysql -uroot -pgertec -D GERTEC_MDM_DEV
+-- 5) After delete, run verify_deleted_devices.sql to confirm status.
